# Release-signing config for local/maintainer release builds (#84).
#
# Copy this file to `android/keystore.properties` (gitignored — NEVER commit the
# real one or the .jks) and fill in the values for your upload keystore. The
# build reads it via build.gradle.kts; if it's absent, debug builds work
# normally and `bundleRelease` produces an unsigned AAB.
#
# Generate the upload keystore OUTSIDE the repo tree, e.g.:
#   keytool -genkeypair -v -keystore ~/keys/semaphore-upload.jks \
#     -alias semaphore-upload -keyalg RSA -keysize 2048 -validity 10000
#
# Then point storeFile at that absolute path. With Play App Signing enabled,
# this is the *upload* key (Google holds the app signing key).

storeFile=/absolute/path/to/semaphore-upload.jks
storePassword=changeit
keyAlias=semaphore-upload
keyPassword=changeit
