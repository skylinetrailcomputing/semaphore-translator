# Claude Code maintainer-only context
CLAUDE.local.md

# macOS
.DS_Store

# Xcode / iOS
# The .xcodeproj is generated from ios/project.yml by XcodeGen — see
# ios/README.md. project.yml is the committed source of truth.
ios/*.xcodeproj/
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/**/DerivedData/
ios/**/build/
*.xcscmblueprint

# Android / Gradle
android/.gradle/
android/build/
android/**/build/
android/local.properties
*.iml
.idea/

# Python (model/ training pipeline)
__pycache__/
*.pyc
.venv/
.python-version

# NOTE: model/artifacts/ exported models (.mlmodel/.mlpackage, .tflite)
# are intentionally NOT ignored — they are checked-in artifacts per
# docs/semaphore-translator-spec.md §6.

# Secrets, signing material, and maintainer-only docs — never commit.
# The Android upload keystore lives OUTSIDE the repo tree; only a
# git-ignored keystore.properties points at it (see CONTRIBUTING.md).
.env
.env.*
!.env.example
_private/
keystore.properties
*.jks
*.keystore
